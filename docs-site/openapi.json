{"openapi":"3.1.0","info":{"title":"Orinuno API","description":"API for parsing video content from Kodik","version":"1.0.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Content","description":"CRUD operations for parsed Kodik content"},{"name":"Stream","description":"Video streaming proxy"},{"name":"Download","description":"Video download to local storage"},{"name":"Sources","description":"Per-source capabilities and ad-hoc decoder sandbox"},{"name":"ParseRequests","description":"Async parse-request log: submit a request and poll completion. kodik-parser must not poll status here — use GET /api/v1/export/ready?updatedSince="},{"name":"Calendar","description":"Public Kodik calendar dump (premiere schedule)"},{"name":"Providers","description":"Ad-hoc decoder sandbox for Sibnet/Aniboom/JutSu"},{"name":"Parse","description":"Trigger parsing and decoding operations"},{"name":"Reference","description":"Typed Kodik reference dictionaries (cached)"},{"name":"Kodik","description":"Thin proxy over the Kodik HTTP API"},{"name":"Export","description":"Export parsed content data for external consumers"},{"name":"Multi-source","description":"AP-7: ranked provider candidates for an episode"},{"name":"Health","description":"Service health and diagnostics"},{"name":"HLS","description":"HLS manifest retrieval for streaming integration"},{"name":"Embed","description":"Resolve a Kodik player iframe URL by external id (shikimori, kinopoisk, imdb, mdl, kodik, worldart_animation, worldart_cinema). Lightweight, no DB write."},{"name":"Sources","description":"JutSu CDN pass-through proxy (PROXY-1)"}],"paths":{"/api/v1/sources/{provider}/decode":{"post":{"tags":["Sources"],"summary":"Decode a single source URL ad-hoc","description":"Stateless decoder dispatch keyed by path segment. Supported providers: kodik, sibnet, aniboom, jutsu. Returns a uniform ProviderDecodeResult with {success, qualities, format, errorCode}. No DB write, no caching.","operationId":"decode","parameters":[{"name":"provider","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DecodeRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProviderDecodeResult"}}}}}}},"/api/v1/providers/decode":{"post":{"tags":["Providers"],"summary":"[Deprecated] use POST /api/v1/sources/{provider}/decode","description":"Legacy decoder dispatch kept only for backwards compatibility. The canonical path is POST /api/v1/sources/{provider}/decode where {provider} is one of kodik / sibnet / aniboom / jutsu and the request body is just {\"url\": \"...\"}. This endpoint will be removed after consumers migrate.","operationId":"decode_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProviderDecodeRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProviderDecodeResult"}}}}},"deprecated":true}},"/api/v1/parse/search":{"post":{"tags":["Parse"],"summary":"Search and parse content from Kodik","operationId":"search","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ParseRequestDto"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ContentDto"}}}}}}}},"/api/v1/parse/requests":{"get":{"tags":["ParseRequests"],"summary":"List parse requests","description":"X-Total-Count header reports the total matching rows for the supplied status filter. Use limit=0 to obtain only the count without rows.","operationId":"list","parameters":[{"name":"status","in":"query","description":"Filter by status","required":false,"schema":{"type":"string","enum":["PENDING","RUNNING","DONE","FAILED"]}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":50}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ParseRequestDtoView"}}}}}}},"post":{"tags":["ParseRequests"],"summary":"Submit a parse request (idempotent by canonical-JSON SHA-256)","description":"Returns 201 for newly-created requests and 200 for an existing active (PENDING/RUNNING) request with the same hash.","operationId":"submit","parameters":[{"name":"X-Created-By","in":"header","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ParseRequestDto"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ParseRequestDtoView"}}}}}}},"/api/v1/parse/decode/{contentId}":{"post":{"tags":["Parse"],"summary":"Decode mp4 links for specific content","operationId":"decode_2","parameters":[{"name":"contentId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"force","in":"query","required":false,"schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"OK"}}}},"/api/v1/parse/decode/variant/{variantId}":{"post":{"tags":["Parse"],"summary":"Decode mp4 link for a single variant","operationId":"decodeVariant","parameters":[{"name":"variantId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"force","in":"query","required":false,"schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/download/{variantId}":{"post":{"tags":["Download"],"summary":"Start downloading a single variant (returns immediately, poll status via GET)","operationId":"downloadVariant","parameters":[{"name":"variantId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DownloadState"}}}}}}},"/api/v1/download/content/{contentId}":{"post":{"tags":["Download"],"summary":"Download all undecoded variants for a content item","operationId":"downloadContent","parameters":[{"name":"contentId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/stream/{variantId}":{"get":{"tags":["Stream"],"summary":"Stream video — serves local file if downloaded, otherwise proxies from CDN","operationId":"stream","parameters":[{"name":"variantId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK"}}}},"/api/v1/sources":{"get":{"tags":["Sources"],"summary":"List supported video sources and their capabilities","description":"Returns one entry per provider with the operations it exposes, whether credentials are required for premium content, and whether they are currently configured. Safe to call without authentication.","operationId":"capabilities","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/sources/{contentId}/{season}/{episode}":{"get":{"tags":["Multi-source"],"summary":"[Deprecated] use /api/v1/anime/{contentId}/episodes/{s}/{e}/sources","description":"Legacy short path kept so the demo UI keeps working during the API/module split. Same response shape, same semantics. Remove after the new path is documented and consumers migrate.","operationId":"ranked","parameters":[{"name":"contentId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"season","in":"path","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"episode","in":"path","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"prefer","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}},"deprecated":true}},"/api/v1/sources/jutsu/stream":{"get":{"tags":["Sources"],"summary":"Stream a jut.su CDN URL through backend's session","description":"Re-issues the GET against the upstream URL using backend's authenticated jut.su session and streams the response back to the browser without buffering. Required because Yandex CDN signs URLs against the originating session — a URL fetched by backend cannot be opened directly by the browser. Whitelisted to *.yandexwebcache.org. Pass ?filename=... to receive a Content-Disposition: attachment header so the browser triggers a download with the supplied filename instead of inline playback.","operationId":"stream_1","parameters":[{"name":"url","in":"query","required":true,"schema":{"type":"string"}},{"name":"filename","in":"query","required":false,"schema":{"type":["string","null"]}}],"responses":{"200":{"description":"OK"}}}},"/api/v1/reference/years":{"get":{"tags":["Reference"],"summary":"List years with content counts (cached)","operationId":"years","parameters":[{"name":"fresh","in":"query","required":false,"schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/KodikReferenceResponseKodikYearDto"}}}}}}},"/api/v1/reference/translations":{"get":{"tags":["Reference"],"summary":"List translation authors (cached)","operationId":"translations","parameters":[{"name":"fresh","in":"query","description":"Skip cache and hit Kodik directly","required":false,"schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/KodikReferenceResponseKodikTranslationDto"}}}}}}},"/api/v1/reference/qualities":{"get":{"tags":["Reference"],"summary":"List qualities (cached)","operationId":"qualities","parameters":[{"name":"fresh","in":"query","required":false,"schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/KodikReferenceResponseKodikQualityDto"}}}}}}},"/api/v1/reference/genres":{"get":{"tags":["Reference"],"summary":"List genres (cached)","operationId":"genres","parameters":[{"name":"fresh","in":"query","required":false,"schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/KodikReferenceResponseKodikGenreDto"}}}}}}},"/api/v1/reference/countries":{"get":{"tags":["Reference"],"summary":"List countries (cached)","operationId":"countries","parameters":[{"name":"fresh","in":"query","required":false,"schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/KodikReferenceResponseKodikCountryDto"}}}}}}},"/api/v1/providers/jutsu/stream":{"get":{"tags":["Sources"],"summary":"[Deprecated] use GET /api/v1/sources/jutsu/stream","description":"Legacy alias for the canonical /api/v1/sources/jutsu/stream. Same handler, same semantics, kept only so existing frontends keep working during the transition. Remove after at least one minor release.","operationId":"streamLegacy","parameters":[{"name":"url","in":"query","required":true,"schema":{"type":"string"}},{"name":"filename","in":"query","required":false,"schema":{"type":["string","null"]}}],"responses":{"200":{"description":"OK"}},"deprecated":true}},"/api/v1/parse/requests/{id}":{"get":{"tags":["ParseRequests"],"summary":"Fetch a single parse request by id","operationId":"findById","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ParseRequestDtoView"}}}}}}},"/api/v1/kodik/list":{"get":{"tags":["Kodik"],"summary":"Proxy GET /list — minimal subset of fields","operationId":"list_1","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"types","in":"query","required":false,"schema":{"type":"string"}},{"name":"year","in":"query","required":false,"schema":{"type":"string"}},{"name":"translation_id","in":"query","required":false,"schema":{"type":"string"}},{"name":"translation_type","in":"query","required":false,"schema":{"type":"string"}},{"name":"sort","in":"query","required":false,"schema":{"type":"string"}},{"name":"order","in":"query","required":false,"schema":{"type":"string"}},{"name":"anime_status","in":"query","required":false,"schema":{"type":"string"}},{"name":"drama_status","in":"query","required":false,"schema":{"type":"string"}},{"name":"all_status","in":"query","required":false,"schema":{"type":"string"}},{"name":"with_material_data","in":"query","required":false,"schema":{"type":"boolean"}},{"name":"next_page","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/KodikListPageView"}}}}}}},"/api/v1/hls/{variantId}/url":{"get":{"tags":["HLS"],"summary":"Get fresh m3u8 URL for a variant (requires fresh decode)","operationId":"getHlsUrl","parameters":[{"name":"variantId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}}}}},"/api/v1/hls/{variantId}/manifest":{"get":{"tags":["HLS"],"summary":"Get absolutized m3u8 manifest for a variant (fresh decode + download + absolutize)","operationId":"getAbsolutizedManifest","parameters":[{"name":"variantId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"application/vnd.apple.mpegurl":{"schema":{"type":"string"}}}}}}},"/api/v1/health":{"get":{"tags":["Health"],"summary":"General health check","operationId":"health","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/health/tokens":{"get":{"tags":["Health"],"summary":"Kodik token registry status (masked)","operationId":"tokensHealth","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/health/schema-drift":{"get":{"tags":["Health"],"summary":"Kodik API schema drift detection status","operationId":"schemaDrift","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/health/proxy":{"get":{"tags":["Health"],"summary":"Proxy pool statistics","operationId":"proxyHealth","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/health/integration":{"get":{"tags":["Health"],"summary":"Aggregated readiness for downstream consumers (READY/DEGRADED/BLOCKED)","description":"Single endpoint for kodik-parser (and similar) to check before submitting work. Aggregates token registry, schema-drift, parse-request queue depth.","operationId":"integrationHealth","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/health/dumps":{"get":{"tags":["Health"],"summary":"Kodik public dump endpoints (DUMP-1)","description":"Returns the latest known state for every tracked Kodik dump (calendar.json / serials.json / films.json). When orinuno.dumps.enabled=false the snapshot is empty.","operationId":"dumpsHealth","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/health/decoder":{"get":{"tags":["Health"],"summary":"Decoder health and statistics (PF6)","operationId":"decoderHealth","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/health/decoder/path-cache":{"get":{"tags":["Health"],"summary":"Per-netloc decoder path cache (DECODE-2)","description":"Returns the in-memory snapshot of the persistent video-info POST path cache. Hydrated from kodik_decoder_path_cache on startup; updated on every successful decode that resolves a fresh netloc.","operationId":"decoderPathCacheHealth","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/export/{contentId}":{"get":{"tags":["Export"],"summary":"Get full export package for specific content","operationId":"getExportData","parameters":[{"name":"contentId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ContentExportDto"}}}}}}},"/api/v1/export/ready":{"get":{"tags":["Export"],"summary":"List content ready for export (with decoded mp4 links)","operationId":"getReadyForExport","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}},{"name":"updatedSince","in":"query","description":"Only return content updated after this timestamp (ISO 8601)","required":false,"schema":{"type":"string","format":"date-time"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseContentExportDto"}}}}}}},"/api/v1/embed/{idType}/{id}":{"get":{"tags":["Embed"],"summary":"Resolve a Kodik embed iframe URL by external id","description":"Calls Kodik's /get-player helper and returns the resolved kodikplayer.com iframe URL plus minimal metadata. The endpoint is read-only — it does not write to the database and does not trigger the video decoder. Use /api/v1/parse/search if you also want to ingest the content.\n\n**Supported idType values (snake_case or kebab-case accepted):**\n- `shikimori` — Shikimori id (numeric, e.g. `20`)\n- `kinopoisk` — Kinopoisk id (numeric)\n- `imdb` — IMDb id; the `tt` prefix is added automatically when missing\n- `mdl` — MyDramaList id\n- `kodik` — native Kodik id, must be supplied as `serial-{n}` or `movie-{n}`\n- `worldart_animation` — World Art animation id\n- `worldart_cinema` — World Art cinema id\n\nAuth: subject to `X-API-KEY` when `orinuno.security.api-key` is configured.","operationId":"resolve","parameters":[{"name":"idType","in":"path","description":"External id source","required":true,"schema":{"type":"string"},"example":"shikimori"},{"name":"id","in":"path","description":"External id value","required":true,"schema":{"type":"string"},"example":20}],"responses":{"200":{"description":"Embed resolved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmbedLinkDto"}}}},"400":{"description":"Unknown idType or empty id","content":{"application/json":{}}},"404":{"description":"Kodik has no player for the supplied id","content":{"application/json":{}}},"502":{"description":"Kodik returned a non-recoverable upstream error","content":{"application/json":{}}},"503":{"description":"No working Kodik token available","content":{"application/json":{}}}}}},"/api/v1/download/{variantId}/status":{"get":{"tags":["Download"],"summary":"Check download status for a variant","operationId":"getStatus","parameters":[{"name":"variantId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DownloadState"}}}}}}},"/api/v1/content":{"get":{"tags":["Content"],"summary":"List all content with pagination","operationId":"findAll","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}},{"name":"sortBy","in":"query","required":false,"schema":{"type":"string","default":"id"}},{"name":"order","in":"query","required":false,"schema":{"type":"string","default":"ASC"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseContentDto"}}}}}}},"/api/v1/content/{id}":{"get":{"tags":["Content"],"summary":"Get content by ID","operationId":"findById_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ContentDto"}}}}}}},"/api/v1/content/{id}/variants":{"get":{"tags":["Content"],"summary":"Get all episode variants for content","operationId":"findVariants","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/EpisodeVariantDto"}}}}}}}},"/api/v1/content/by-kinopoisk/{kinopoiskId}":{"get":{"tags":["Content"],"summary":"Find content by Kinopoisk ID","operationId":"findByKinopoiskId","parameters":[{"name":"kinopoiskId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ContentDto"}}}}}}},"/api/v1/calendar":{"get":{"tags":["Calendar"],"summary":"Fetch the public Kodik calendar dump","description":"Cached on-demand fetcher for https://dumps.kodikres.com/calendar.json (5 min TTL, conditional GET). Filters are optional and combinable.","operationId":"getCalendar","parameters":[{"name":"status","in":"query","description":"Filter by Shikimori status (e.g. ongoing, anons, released)","required":false,"schema":{"type":"string"}},{"name":"kind","in":"query","description":"Filter by Shikimori kind (e.g. tv, movie, ova, ona)","required":false,"schema":{"type":"string"}},{"name":"minScore","in":"query","description":"Inclusive lower bound for Shikimori score","required":false,"schema":{"type":"number","format":"double"}},{"name":"limit","in":"query","description":"Cap returned entries (after filtering)","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"enrich","in":"query","description":"Match Shikimori ids to local kodik_content","required":false,"schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CalendarResponse"}}}}}}},"/api/v1/calendar/outbox":{"get":{"tags":["Calendar"],"summary":"Replay calendar deltas detected by the watcher (CAL-6)","description":"Returns one entry per detected change (NEW_ANIME, NEXT_EPISODE_ADVANCED, STATUS_CHANGED, …) since the supplied watermark. Pull pattern: consumers pass back the last detectedAt they processed. Default watermark = 1970-01-01 (read everything). Capped at 1000 events.","operationId":"outbox","parameters":[{"name":"since","in":"query","description":"Exclusive lower bound on detectedAt (ISO-8601 local datetime; default 1970-01-01T00:00:00)","required":false,"schema":{"type":"string"}},{"name":"limit","in":"query","description":"Cap returned events (1..1000)","required":false,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/v1/anime/{contentId}/episodes/{season}/{episode}/sources":{"get":{"tags":["Multi-source"],"summary":"Ranked provider candidates for an episode (canonical resource path)","description":"Returns episode_source + episode_video rows joined and scored by MultiSourceRanker (AP-7, ADR 0008). Higher score = better choice. This is the canonical resource-style path; the legacy alias is GET /api/v1/sources/{contentId}/{season}/{episode}.","operationId":"rankedByContentId","parameters":[{"name":"contentId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"season","in":"path","required":true,"schema":{"type":"integer","fo