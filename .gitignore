# JVM cwd may resolve relative ./data to orinuno-app/data when launched via java -jar from root.
# Mirror the data/* whitelist here so token state never escapes the local checkout.
orinuno-app/data/*
!orinuno-app/data/README.md

### Environment ###
.env
*.env.local

### Python (helper scripts under scripts/research/) ###
__pycache__/
*.pyc

# Per-source service runtime data when launched via `mvn spring-boot:run`
# from each module dir. Mirror the orinuno-app/data/* exclusion.
orinuno-source-kodik/data/
orinuno-source-jutsu/data/
