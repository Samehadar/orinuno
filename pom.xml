<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.orinuno</groupId>
    <artifactId>orinuno-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>orinuno (multi-module)</name>
    <description>Orinuno reactor: Kodik SDK pieces + the orinuno service.</description>

    <!--
        Multi-module split landed in PR3 of the transparency roadmap. See:
        - docs/adr/0001-kodik-sdk-extraction.md
        - BACKLOG.md → IDEA-SDK-1..4

        The Spring Boot parent is intentionally NOT applied at the reactor
        level: only orinuno-app needs Boot's plugin management. The drift
        SDK module stays Spring-free on purpose.
    -->

    <!--
        Module set is profile-driven (ADR 0018 Phase 2.10):

          • Default / -P full-split (active when no profile picked):
              all modules, including the per-source standalone deployables
              (orinuno-source-kodik, future orinuno-source-jutsu, …).

          • -P monolith:
              skips the per-source deployables and only builds the libraries
              + orinuno-app. orinuno-app already carries every Kodik
              controller/service internally (Phase 2.8 reverse-proxy is gated
              by orinuno.source-kodik.base-url), so the resulting fat jar is
              a fully-functional monolith — matches the OSS contributor DX
              promised in ADR 0018 §"Reference projects".

          • The "core" modules (libraries + orinuno-app) live under the
            full-split profile too, not under <modules>, so Maven's profile
            override rules give us the clean "monolith = subset" behaviour
            without duplicating the module list in two places.
    -->
    <modules>
        <module>orinuno-source-contract</module>
        <module>kodik-sdk</module>
        <module>kodik-sdk-spring-boot-starter</module>
        <module>jutsu-sdk</module>
        <module>sibnet-sdk</module>
        <module>aniboom-sdk</module>
        <module>orinuno-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jackson.version>2.18.2</jackson.version>
        <lombok.version>1.18.36</lombok.version>
        <slf4j.version>2.0.16</slf4j.version>
        <junit-jupiter.version>5.11.4</junit-jupiter.version>
        <assertj.version>3.27.6</assertj.version>
        <spotless-maven-plugin.version>2.46.1</spotless-maven-plugin.version>
        <google-java-format.version>1.22.0</google-java-format.version>
        <!--
            jutsu-sdk transitive deps. Versions match what spring-boot-starter-parent 3.5.x ships
            today so the SDK and orinuno-app stay binary-compatible inside the same reactor build.
        -->
        <spring-webflux.version>6.2.18</spring-webflux.version>
        <reactor.version>3.7.18</reactor.version>
        <reactor-netty.version>1.2.17</reactor-netty.version>
        <bucket4j.version>8.18.0</bucket4j.version>
        <micrometer.version>1.15.11</micrometer.version>
        <jakarta-annotation.version>2.1.1</jakarta-annotation.version>
        <!--
            HTML parser used by jutsu-sdk catalog/info/notice subpackages and orinuno-app.
            Centralised here so SDK and app stay in lock-step; bumping in one place
            forbids accidental drift.
        -->
        <jsoup.version>1.22.2</jsoup.version>
        <!--
            Spring Boot version matches what spring-boot-starter-parent 3.5.x ships so the
            kodik-sdk-spring-boot-starter is binary-compatible with orinuno-app at runtime.
        -->
        <spring-boot.version>3.5.14</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.orinuno</groupId>
                <artifactId>orinuno-source-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orinuno</groupId>
                <artifactId>kodik-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orinuno</groupId>
                <artifactId>kodik-sdk-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orinuno</groupId>
                <artifactId>jutsu-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orinuno</groupId>
                <artifactId>sibnet-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orinuno</groupId>
                <artifactId>aniboom-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <java>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                            <googleJavaFormat>
                                <version>${google-java-format.version}</version>
                                <style>AOSP</style>
                                <reflowLongStrings>true</reflowLongStrings>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            full-split (default): build the entire per-source service stack
            on top of the core libs + orinuno-app. This is the production
            deployment shape — orinuno gateway in front of standalone
            per-source services.
        -->
        <profile>
            <id>full-split</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>orinuno-source-kodik</module>
                <module>meter</module>
            </modules>
        </profile>

        <!--
            monolith: skips per-source standalone deployables. orinuno-app
            still ships every Kodik controller/service internally (the
            Phase 2.8 reverse-proxy filter is gated by
            orinuno.source-kodik.base-url being set), so leaving that env
            unset keeps everything in a single Spring Boot process.

            Usage:
                mvn -P monolith clean package
                docker compose -f docker-compose.yml -f docker-compose.monolith.yml up
        -->
        <profile>
            <id>monolith</id>
            <!-- Intentionally empty <modules> — relies on the base list
                 above for the core build set, omits source-kodik. -->
        </profile>
    </profiles>
</project>
