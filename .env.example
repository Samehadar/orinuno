KODIK_TOKEN=your_kodik_api_token_here

KODIK_TOKEN_FILE=./data/kodik_tokens.json
KODIK_TOKEN_VALIDATION_INTERVAL_MINUTES=360
KODIK_TOKEN_AUTO_DISCOVERY_ENABLED=true
KODIK_TOKEN_BOOTSTRAP_FROM_ENV=true
KODIK_TOKEN_FAILOVER_MAX_ATTEMPTS=3
KODIK_TOKEN_VALIDATE_ON_STARTUP=true

# JutSu (jut.su) — optional. Without these, premium-gated episodes return
# JUTSU_PREMIUM_REQUIRED. With them, the decoder logs in via the DLE form,
# caches the cookie jar, and gets real CDN URLs. Treat the password like any
# other secret: never commit to git, never check into a wiki.
#
# rate-limit-rps is hard-capped at 1 req/sec by default to keep the account
# off jut.su's API-abuse radar. Raise only if you have a separate agreement.
JUTSU_USERNAME=
JUTSU_PASSWORD=
JUTSU_RATE_LIMIT_RPS=1.0
JUTSU_SESSION_TTL_MINUTES=240
# jut.su mirror domain. Default https://jut.su; some geos (e.g. RU after
# Cloudflare blocks) need https://jutsu.ru. Same site, identical HTML
# structure — the SDK reads this for all upstream calls + Origin/Referer
# headers + URL absolutization. Override per-deploy if your network blocks
# the canonical host.
PROVIDERS_JUTSU_BASE_URL=https://jut.su
